#include <behaviors.dtsi>
#include <dt-bindings/zmk/bt.h>
#include <dt-bindings/zmk/keys.h>
#include <dt-bindings/zmk/pointing.h>

/ {
    chosen { zmk,physical-layout = &gggw_crosses_42_layout; };

    combos {
        compatible = "zmk,combos";

        bluetooth_layer {
            bindings = <&mo 4>;
            key-positions = <37 40>;
        };
    };

    behaviors {
        CLEAR_BT: CLEAR_BT {
            compatible = "zmk,behavior-tap-dance";
            label = "CLEAR_BT";
            #binding-cells = <0>;
            bindings = <&bt BT_CLR>, <&bt BT_CLR_ALL>;
        };
    };

    keymap {
        compatible = "zmk,keymap";

        default_layer {
            display-name = "Base";
            bindings = <
&kp TAB    &kp Q  &kp W  &kp E  &kp R  &kp T                  &kp Y    &kp U  &kp I      &kp O    &kp P     &kp BSPC
&kp LCTRL  &kp A  &kp S  &kp D  &kp F  &kp G                  &kp H    &kp J  &kp K      &kp L    &kp SEMI  &kp SQT
&kp LSHFT  &kp Z  &kp X  &kp C  &kp V  &kp B                  &kp N    &kp M  &kp COMMA  &kp DOT  &kp FSLH  &kp RIGHT_SHIFT
                         &mo 3  &mo 1  &mt LEFT_ALT LEFT_GUI  &kp RET  &mo 2  &kp SPACE
            >;
        };

        lower_layer {
            display-name = "Lower";
            bindings = <
&kp TAB           &trans  &trans  &trans  &trans  &trans  &trans  &kp KP_NUMBER_7  &kp KP_NUMBER_8  &kp KP_NUMBER_9  &trans      &kp BSPC
&kp LEFT_CONTROL  &trans  &trans  &trans  &trans  &trans  &trans  &kp KP_NUMBER_4  &kp KP_NUMBER_5  &kp KP_NUMBER_6  &trans      &trans
&kp LSHFT         &trans  &trans  &trans  &trans  &trans  &trans  &kp KP_NUMBER_1  &kp KP_NUMBER_2  &kp KP_NUMBER_3  &kp KP_DOT  &kp RIGHT_SHIFT
                                  &trans  &trans  &trans  &trans  &trans           &kp KP_NUMBER_0
            >;
        };

        raise_layer {
            display-name = "Raise";
            bindings = <
&kp GRAVE  &kp NUMBER_1  &kp NUMBER_2  &kp NUMBER_3  &kp NUMBER_4  &kp N5  &kp NUMBER_6  &kp N7     &kp N8     &kp N9    &kp N0    &kp BSPC
&kp LCTRL  &trans        &trans        &trans        &trans        &trans  &kp MINUS     &kp EQUAL  &kp LBKT   &kp RBKT  &kp BSLH  &mo 5
&kp LSHFT  &trans        &trans        &trans        &trans        &trans  &kp UNDER     &kp PLUS   &kp LBRC   &kp RBRC  &kp PIPE  &kp RIGHT_SHIFT
                                       &trans        &trans        &trans  &trans        &trans     &kp SPACE
            >;
        };

        mouse_layer {
            display-name = "Mouse";
            bindings = <
&kp ESCAPE  &trans  &trans     &trans     &trans     &trans  &trans  &trans    &kp UP_ARROW  &trans     &trans  &trans
&caps_word  &trans  &mkp RCLK  &mkp MCLK  &mkp LCLK  &trans  &trans  &kp LEFT  &kp DOWN      &kp RIGHT  &trans  &trans
&kp K_LOCK  &trans  &trans     &trans     &trans     &trans  &trans  &trans    &trans        &trans     &trans  &trans
                               &trans     &trans     &trans  &trans  &trans    &trans
            >;
        };

        bluetooth_layer {
            bindings = <
&trans  &bt BT_SEL 0  &bt BT_SEL 1  &bt BT_SEL 2  &bt BT_SEL 3  &bt BT_SEL 4  &trans          &kp K_MUTE    &kp C_VOLUME_UP    &trans              &trans      &CLEAR_BT
&trans  &trans        &trans        &trans        &trans        &trans        &kp C_PREVIOUS  &kp C_REWIND  &kp K_PLAY_PAUSE   &kp C_FAST_FORWARD  &kp C_NEXT  &trans
&trans  &trans        &trans        &trans        &trans        &trans        &trans          &trans        &kp C_VOLUME_DOWN  &trans              &trans      &trans
                                    &trans        &trans        &trans        &trans          &trans        &trans
            >;
        };

        Fn {
            bindings = <
&trans  &kp F1   &kp F2  &kp F3  &kp F4  &kp F5  &kp F6  &kp F7  &kp F8  &kp F9  &kp F10  &kp F11
&trans  &kp F12  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans   &trans
&trans  &trans   &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans   &trans
                         &trans  &trans  &trans  &trans  &trans  &trans
            >;
        };
    };
};

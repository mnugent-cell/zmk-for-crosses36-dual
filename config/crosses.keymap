#include <behaviors.dtsi>
#include <dt-bindings/zmk/bt.h>
#include <dt-bindings/zmk/keys.h>
#include <dt-bindings/zmk/pointing.h>

/ {
    chosen { zmk,physical-layout = &gggw_crosses_42_layout; };

    combos {
        compatible = "zmk,combos";

        bluetooth_layer {
            bindings = <&mo 5>;
            key-positions = <37 40>;
        };

        studio_unlock {
            bindings = <&studio_unlock>;
            key-positions = <35 24>;
            layers = <5>;
        };

        left_gui_combo {
            bindings = <&kp LEFT_GUI>;
            key-positions = <36 37>;
        };

        CTRL+ALT+DEL {
            bindings = <&kp LC(LA(DEL))>;
            key-positions = <38 37 36>;
        };

        power_menu {
            bindings = <&kp K_POWER>;
            key-positions = <41 40 39>;
        };

        escape_combo {
            bindings = <&kp ESC>;
            key-positions = <38 37>;
        };
    };

    behaviors {
        CLEAR_BT: CLEAR_BT {
            compatible = "zmk,behavior-tap-dance";
            label = "CLEAR_BT";
            #binding-cells = <0>;
            bindings = <&bt BT_CLR>, <&bt BT_CLR_ALL>;
        };
    };

    keymap {
        compatible = "zmk,keymap";

        default_layer {
            display-name = "Base";
            bindings = <
&kp TAB    &kp Q  &kp W  &kp E  &kp R  &kp T         &kp Y    &kp U  &kp I      &kp O    &kp P     &kp BSPC
&kp LCTRL  &kp A  &kp S  &kp D  &kp F  &kp G         &kp H    &kp J  &kp K      &kp L    &kp SEMI  &kp APOSTROPHE
&kp LSHFT  &kp Z  &kp X  &kp C  &kp V  &kp B         &kp N    &kp M  &kp COMMA  &kp DOT  &kp FSLH  &kp RIGHT_SHIFT
                         &mo 4  &mo 1  &kp LEFT_ALT  &kp RET  &mo 2  &kp SPACE
            >;
        };

        lower_layer {
            display-name = "Lower";
            bindings = <
&trans  &trans  &kp PAGE_UP    &kp HOME  &kp INSERT  &trans  &trans  &kp KP_NUMBER_7  &kp KP_NUMBER_8  &kp KP_NUMBER_9  &kp LS(KP_MINUS)  &trans
&trans  &trans  &kp PAGE_DOWN  &kp END   &kp DELETE  &trans  &trans  &kp KP_NUMBER_4  &kp KP_NUMBER_5  &kp KP_NUMBER_6  &kp KP_PLUS       &none
&trans  &trans  &trans         &trans    &trans      &trans  &trans  &kp KP_NUMBER_1  &kp KP_NUMBER_2  &kp KP_NUMBER_3  &kp KP_DOT        &trans
                               &trans    &trans      &trans  &trans  &trans           &kp KP_NUMBER_0
            >;
        };

        raise_layer {
            display-name = "Raise";
            bindings = <
&kp GRAVE  &kp NUMBER_1  &kp NUMBER_2  &kp NUMBER_3  &kp NUMBER_4  &kp N5  &kp NUMBER_6  &kp N7     &kp N8     &kp N9    &kp N0    &trans
&trans     &none         &none         &none         &none         &none   &kp MINUS     &kp EQUAL  &kp LBKT   &kp RBKT  &kp BSLH  &mo 3
&trans     &none         &none         &none         &none         &none   &kp UNDER     &kp PLUS   &kp LBRC   &kp RBRC  &kp PIPE  &trans
                                       &trans        &trans        &trans  &trans        &trans     &kp SPACE
            >;
        };

        Fn {
            bindings = <
&kp TAB  &kp F1   &kp F2  &kp F3  &kp F4  &kp F5  &kp F6  &kp F7  &kp F8  &kp F9  &kp F10  &kp F11
&trans   &kp F12  &none   &none   &none   &none   &none   &none   &none   &none   &none    &trans
&trans   &none    &none   &none   &none   &none   &none   &none   &none   &none   &none    &trans
                          &trans  &trans  &trans  &trans  &trans  &trans
            >;
        };

        mouse_layer {
            display-name = "Mouse";
            bindings = <
&trans  &none  &none      &none      &none      &none   &none   &none     &kp UP    &none      &none  &none
&trans  &none  &mkp RCLK  &mkp MCLK  &mkp LCLK  &none   &none   &kp LEFT  &kp DOWN  &kp RIGHT  &none  &trans
&trans  &none  &none      &none      &none      &none   &none   &none     &none     &none      &none  &trans
                          &trans     &trans     &trans  &trans  &trans    &trans
            >;
        };

        bluetooth_layer {
            bindings = <
&none  &bt BT_SEL 0  &bt BT_SEL 1  &bt BT_SEL 2  &bt BT_SEL 3  &bt BT_SEL 4  &none           &kp K_MUTE    &kp C_VOLUME_UP    &none               &none       &CLEAR_BT
&none  &none         &none         &none         &none         &none         &kp C_PREVIOUS  &kp C_REWIND  &kp K_PLAY_PAUSE   &kp C_FAST_FORWARD  &kp C_NEXT  &none
&none  &none         &none         &none         &none         &none         &none           &none         &kp C_VOLUME_DOWN  &none               &none       &none
                                   &trans        &trans        &trans        &trans          &trans        &trans
            >;
        };
    };
};
